# =============================================================================
# senapsa eRechnung-Konverter — zentrale Konfiguration
# -----------------------------------------------------------------------------
# Kopieren nach ".env" und anpassen. Alle Dienste lesen AUSSCHLIESSLICH hieraus.
# Keine Secrets im Image/Code. Diese Datei (.example) enthaelt nur Platzhalter.
# =============================================================================

# --- Allgemein ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=senapsa-erechnung
# Version der eigenen Images (webapp, worker, engine, validator). Leer/weg-
# gelassen = "latest" (Entwicklung). Fuer Produktion auf eine konkrete Version
# pinnen (z.B. IMAGE_TAG=1.0.0) -> reproduzierbare Deployments; Rollback =
# Wert aendern + `docker compose up -d`. Drittsoftware (postgres/redis) ist
# unabhaengig davon fest gepinnt.
IMAGE_TAG=
# Nach aussen exponierter Port der Webanwendung (einziger offener Port).
WEBAPP_PORT=8080
# Log-Level fuer alle Dienste: DEBUG | INFO | WARN | ERROR
LOGLEVEL=INFO
# Zeitzone der Container
TZ=Europe/Berlin

# --- White-Label / Branding (nur diese Werte sind fuer Kunden sichtbar) ------
BRAND_NAME=senapsa
BRAND_PRODUCT_TITLE=eRechnung-Konverter
# Logo (SVG/PNG/JPG): Pfad INNERHALB des webapp-Containers. Standard = das im
# Image mitgelieferte senapsa-Logo. Eigenes Kundenlogo: Datei ins Datenvolumen
# legen und den Pfad umstellen, z.B.:
#   docker compose cp mein-logo.svg webapp:/data/branding/logo.svg
#   BRAND_LOGO_PATH=/data/branding/logo.svg
# Leer oder Datei nicht vorhanden -> automatisch Buchstaben-Avatar aus BRAND_NAME.
BRAND_LOGO_PATH=/app/branding/logo.svg
BRAND_PRIMARY_COLOR=#0B5FFF

# --- Datenbank (PostgreSQL 17) ----------------------------------------------
POSTGRES_DB=erechnung
POSTGRES_USER=erechnung
# PFLICHT aendern: kein Default-Passwort im Produktivbetrieb.
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis 7 (Job-Queue) -----------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-in-production

# --- Auth / Sicherheit -------------------------------------------------------
# HMAC-Secret fuer JWT (mind. 32 Zeichen zufaellig erzeugen).
JWT_SECRET=change-me-please-use-a-long-random-value
JWT_EXPIRY_MINUTES=480
# Initialer Admin-Benutzer, wird beim ersten Start angelegt.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production
# Account-Lockout gegen Brute-Force: Sperre nach N Fehlversuchen fuer M Minuten.
AUTH_MAX_LOGIN_FAILURES=5
AUTH_LOCK_MINUTES=15

# --- Upload ------------------------------------------------------------------
# Maximale Uploadgroesse je Datei in Megabyte.
MAX_UPLOAD_MB=25

# --- Interne Service-URLs (im Netz sic-net, nicht nach aussen exponiert) -----
EXTRACTION_URL=http://extraction-worker:8000
OCR_URL=http://ocr-worker:8001
INVOICE_ENGINE_URL=http://invoice-engine:8090

# --- Fachpruefung ------------------------------------------------------------
# Toleranz fuer Rundungsdifferenzen bei der Summenpruefung (in Waehrungseinheiten).
ROUNDING_TOLERANCE=0.02
# Standard-Steuersatz (%) fuer Plausibilitaetspruefung.
DEFAULT_VAT_RATE=19

# --- Generierung / Validierung ----------------------------------------------
# Zielsyntax: UBL (Default) | CII (spaeter)
TARGET_SYNTAX=UBL
# Zweite unabhaengige Validierung (KoSIT) aktivieren: true | false
KOSIT_ENABLED=false
# URL des KoSIT-Validator-Dienstes (intern im Netz sic-net).
KOSIT_URL=http://kosit-validator:8092/
# ZUGFeRD PDF/A-3 zusaetzlich erzeugen (nur nach positivem PoC): true | false
ZUGFERD_ENABLED=false

# --- Eigene Firma (Verkaeufer) ----------------------------------------------
# Optionaler Erst-Seed beim ersten Start. Danach im Admin-Bereich pflegbar.
# Wird automatisch als Verkaeufer/Zahlungsweg in jede Rechnung eingefuellt.
COMPANY_NAME=
COMPANY_STREET=
COMPANY_ZIP=
COMPANY_CITY=
COMPANY_COUNTRY=DE
COMPANY_VATID=
COMPANY_TAXNO=
COMPANY_CONTACT=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_IBAN=
COMPANY_BIC=
COMPANY_PAYMENT_TERMS=

# --- Ordner-Automatik (Watch-Folder, optional "Kann") -----------------------
# Startvorgaben; danach im Admin-Bereich "Ordner-Automatik" pflegbar.
WATCH_ENABLED=false
# Container-interne Basispfade (nicht aendern; siehe Host-Ordner unten).
WATCH_INPUT_DIR=/data/watch/in
WATCH_OUTPUT_DIR=/data/watch/out
# Intervall in Sekunden.
WATCH_INTERVAL=60
# Host-Ordner (on-premise). LEER lassen = internes Docker-Volume (Cloud/SFTP,
# kein Host-Setup noetig, Standard). Auf einen Host-Ordner gesetzt = dieser wird
# gebunden und in der Oberflaeche angezeigt. Ein einziges Compose-File genuegt;
# der Mount-Typ ergibt sich aus dem Wert (leer -> Volume, Pfad -> Bind).
# WICHTIG: gesetzte Host-Ordner muessen existieren – sonst legt Docker still einen
# leeren Ordner an (ggf. an falscher Stelle). Vorher pruefen:
#   sh scripts/preflight-check.sh
# Windows-Pfade mit Vorwaertsslashes schreiben, z.B. C:/abas/in
WATCH_HOST_INPUT_DIR=
WATCH_HOST_OUTPUT_DIR=

# --- KI-Fallback (optional "Kann", Proof-of-Concept) ------------------------
# Optionaler LLM-Schritt im extraction-worker: fuellt AUSSCHLIESSLICH Felder,
# die CSV/PDF/OCR nicht erkennen konnten (status=fehlt). KI-Werte werden immer
# herkunft=ki/unsicher markiert -> im Pruefbildschirm gelb, nie Auto-Export.
# Standard AUS. DSGVO-Hinweis: bei "true" wird der extrahierte Rechnungstext an
# OpenRouter (Drittanbieter) gesendet - fuer Produktivbetrieb EU-/self-hosted
# Modell waehlen. Hier PoC.
# Diese Werte sind nur ERST-VORGABEN: beim ersten Start werden sie in die DB
# uebernommen; danach ist der Admin-Bereich "KI-Assistent" massgeblich (die
# webapp gibt die effektiven Werte bei jeder Extraktion an den Worker weiter).
KI_ENABLED=false
# API-Schluessel von https://openrouter.ai/ (nur noetig, wenn KI_ENABLED=true).
OPENROUTER_API_KEY=
# Modell-ID bei OpenRouter (Default: guenstiges, schnelles Modell fuer den PoC).
KI_MODEL=openai/gpt-4o-mini
# Timeout je KI-Aufruf in Sekunden.
KI_TIMEOUT=30

# --- Lizenzcontroller (Schnittstelle vorbereitet, Durchsetzung optional) -----
LICENSE_ENFORCEMENT=false
LICENSE_CONTROLLER_URL=
LICENSE_KEY=

# --- Abas-ERP Direktanbindung per REST (Schnittstelle vorbereitet) -----------
# Tragende Anbindung ist dateibasiert (Upload + Ordner-Automatik), weil aeltere
# Abas-Versionen kein XML erzeugen. Eine direkte REST-Anbindung ist laut Scope
# "Spaeter" (weitere ERP-Systeme). Die Schnittstelle (InvoiceSource /
# AbasApiInvoiceSource) ist vorbereitet, aber NOCH NICHT implementiert: bei
# "true" wird nur ein Hinweis geloggt, es wird nichts abgerufen. Standard AUS.
ABAS_API_ENABLED=false
ABAS_API_BASE_URL=
ABAS_API_KEY=
